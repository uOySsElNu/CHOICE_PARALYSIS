    <!-- Privacy Policy -->
    <string name="privacy_last_updated">最后更新日期：2026年6月8日</string>
    <string name="privacy_intro">选择困难症助手（以下简称"本应用"）是一款开源软件，尊重并保护您的隐私。</string>
    <string name="privacy_s1_title">1. 信息收集</string>
    <string name="privacy_s1_body">本应用不会收集、存储或传输任何个人信息。所有决策数据（如转盘选项、历史记录等）仅保存在您的设备本地。</string>
    <string name="privacy_s2_title">2. 数据存储</string>
    <string name="privacy_s2_body">• 所有数据均使用 Android DataStore 和 Room 数据库存储在设备本地\n• 不会上传至任何服务器\n• 卸载应用将清除所有数据</string>
    <string name="privacy_s3_title">3. 数据安全</string>
    <string name="privacy_s3_body">由于所有数据均存储在本地，您的隐私完全由 Android 系统的安全机制保护。</string>
    <string name="privacy_s4_title">4. 第三方服务</string>
    <string name="privacy_s4_body">本应用不集成任何第三方分析、广告或追踪服务。</string>
    <string name="privacy_s5_title">5. 权限使用</string>
    <string name="privacy_s5_body">• 振动权限：仅用于决策时的触觉反馈\n• 不需要网络、存储、相机等任何其他权限</string>
    <string name="privacy_s6_title">6. 开源透明</string>
    <string name="privacy_s6_body">本应用完全开源，您可以在 GitHub 上查看所有源代码。</string>
    <string name="privacy_s7_title">7. 政策更新</string>
    <string name="privacy_s7_body">如有政策更新，将在应用内通知用户。</string>
    <string name="privacy_s8_title">8. 联系我们</string>
    <string name="privacy_s8_body">如有任何隐私相关问题，请通过 GitHub Issues 联系我们。</string>

    <!-- Terms of Use -->
    <string name="terms_last_updated">最后更新日期：2026年6月8日</string>
    <string name="terms_intro">欢迎使用选择困难症助手。本应用是一款开源软件，旨在帮助选择困难的用户做出决策。</string>
    <string name="terms_s1_title">1. 服务说明</string>
    <string name="terms_s1_body">本应用提供以下决策工具：转盘、转硬币、掷骰子、Yes/No 和指尖轮盘。所有功能均免费使用，无内购。</string>
    <string name="terms_s2_title">2. 使用规范</string>
    <string name="terms_s2_body">请合理使用本应用。本应用仅用于辅助日常决策，不适用于任何高风险场景。</string>
    <string name="terms_s3_title">3. 免责声明</string>
    <string name="terms_s3_body">本应用按"现状"提供，不对决策结果的准确性或适用性做任何保证。</string>
