    <!-- Privacy Policy -->
    <string name="privacy_last_updated">最後更新日期：2026年6月8日</string>
    <string name="privacy_intro">選擇困難症助手（以下簡稱「本應用」）是一款開源軟體，尊重並保護您的隱私。</string>
    <string name="privacy_s1_title">1. 資訊收集</string>
    <string name="privacy_s1_body">本應用不會收集、儲存或傳輸任何個人資訊。所有決策資料（如轉盤選項、歷史記錄等）僅儲存在您的裝置本地。</string>
    <string name="privacy_s2_title">2. 資料儲存</string>
    <string name="privacy_s2_body">• 所有資料均使用 Android DataStore 和 Room 資料庫儲存在裝置本地\n• 不會上傳至任何伺服器\n• 解除安裝應用將清除所有資料</string>
    <string name="privacy_s3_title">3. 資料安全</string>
    <string name="privacy_s3_body">由於所有資料均儲存在本地，您的隱私完全由 Android 系統的安全機制保護。</string>
    <string name="privacy_s4_title">4. 第三方服務</string>
    <string name="privacy_s4_body">本應用不整合任何第三方分析、廣告或追蹤服務。</string>
    <string name="privacy_s5_title">5. 權限使用</string>
    <string name="privacy_s5_body">• 振動權限：僅用於決策時的觸覺回饋\n• 不需要網路、儲存、相機等任何其他權限</string>
    <string name="privacy_s6_title">6. 開源透明</string>
    <string name="privacy_s6_body">本應用完全開源，您可以在 GitHub 上檢視所有原始碼。</string>
    <string name="privacy_s7_title">7. 政策更新</string>
    <string name="privacy_s7_body">如有政策更新，將在應用內通知使用者。</string>
    <string name="privacy_s8_title">8. 聯絡我們</string>
    <string name="privacy_s8_body">如有任何隱私相關問題，請透過 GitHub Issues 聯絡我們。</string>

    <!-- Terms of Use -->
    <string name="terms_last_updated">最後更新日期：2026年6月8日</string>
    <string name="terms_intro">歡迎使用選擇困難症助手。本應用是一款開源軟體，旨在幫助選擇困難的使用者做出決策。</string>
    <string name="terms_s1_title">1. 服務說明</string>
    <string name="terms_s1_body">本應用提供以下決策工具：轉盤、轉硬幣、擲骰子、Yes/No 和指尖輪盤。所有功能均免費使用，無內購。</string>
    <string name="terms_s2_title">2. 使用規範</string>
    <string name="terms_s2_body">請合理使用本應用。本應用僅用於輔助日常決策，不適用於任何高風險場景。</string>
    <string name="terms_s3_title">3. 免責聲明</string>
    <string name="terms_s3_body">本應用按「現狀」提供，不對決策結果的準確性或適用性做任何保證。</string>
    <string name="terms_s4_title">4. 智慧財產權</string>
    <string name="terms_s4_body">本應用採用 Apache License 2.0 開源授權發佈。</string>
    <string name="terms_s5_title">5. 使用者權利</string>
    <string name="terms_s5_body">您可以自由使用、修改和分發本應用，但需遵守 Apache License 2.0 的條款。</string>
    <string name="terms_s6_title">6. 責任限制</string>
