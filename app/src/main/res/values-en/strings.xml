    <!-- Privacy Policy -->
    <string name="privacy_last_updated">Last updated: June 8, 2026</string>
    <string name="privacy_intro">Choice Paralysis Helper (\"this app\") is open-source software that respects and protects your privacy.</string>
    <string name="privacy_s1_title">1. Information Collection</string>
    <string name="privacy_s1_body">This app does not collect, store, or transmit any personal information. All decision data (such as wheel options and history) is stored locally on your device only.</string>
    <string name="privacy_s2_title">2. Data Storage</string>
    <string name="privacy_s2_body">• All data is stored locally using Android DataStore and Room database\n• No data is uploaded to any server\n• Uninstalling the app will delete all data</string>
    <string name="privacy_s3_title">3. Data Security</string>
    <string name="privacy_s3_body">Since all data is stored locally, your privacy is fully protected by Android\'s security mechanisms.</string>
    <string name="privacy_s4_title">4. Third-Party Services</string>
    <string name="privacy_s4_body">This app does not integrate any third-party analytics, advertising, or tracking services.</string>
    <string name="privacy_s5_title">5. Permissions</string>
    <string name="privacy_s5_body">• Vibration permission: used only for haptic feedback during decisions\n• No network, storage, camera, or other permissions required</string>
    <string name="privacy_s6_title">6. Open Source Transparency</string>
    <string name="privacy_s6_body">This app is fully open source. You can view all source code on GitHub.</string>
    <string name="privacy_s7_title">7. Policy Updates</string>
    <string name="privacy_s7_body">Any policy updates will be notified within the app.</string>
    <string name="privacy_s8_title">8. Contact Us</string>
    <string name="privacy_s8_body">For any privacy-related questions, please contact us via GitHub Issues.</string>

    <!-- Terms of Use -->
    <string name="terms_last_updated">Last updated: June 8, 2026</string>
    <string name="terms_intro">Welcome to Choice Paralysis Helper. This app is open-source software designed to help indecisive users make decisions.</string>
    <string name="terms_s1_title">1. Service Description</string>
    <string name="terms_s1_body">This app provides the following decision tools: Spin Wheel, Coin Flip, Dice Roll, Yes/No, and Finger Roulette. All features are free with no in-app purchases.</string>
    <string name="terms_s2_title">2. Usage Guidelines</string>
    <string name="terms_s2_body">Please use this app responsibly. It is intended for everyday decisions only and is not suitable for any high-risk scenarios.</string>
    <string name="terms_s3_title">3. Disclaimer</string>
    <string name="terms_s3_body">This app is provided \"as is\" without any warranty regarding the accuracy or suitability of decision results.</string>
    <string name="terms_s4_title">4. Intellectual Property</string>
    <string name="terms_s4_body">This app is released under the Apache License 2.0.</string>
    <string name="terms_s5_title">5. User Rights</string>
    <string name="terms_s5_body">You are free to use, modify, and distribute this app, subject to the terms of the Apache License 2.0.</string>
    <string name="terms_s6_title">6. Limitation of Liability</string>
    <string name="terms_s6_body">To the maximum extent permitted by applicable law, the developer shall not be liable for any damages arising from the use of this app.</string>
    <string name="terms_s7_title">7. Governing Law</string>
    <string name="terms_s7_body">These terms are governed by the laws of the People\'s Republic of China.</string>

