    <!-- Privacy Policy -->
    <string name="privacy_last_updated">آخر تحديث: 8 يونيو 2026</string>
    <string name="privacy_intro">Choice Paralysis Helper (\"هذا التطبيق\") هو برنامج مفتوح المصدر يحترم خصوصيتك ويحميها.</string>
    <string name="privacy_s1_title">1. جمع المعلومات</string>
    <string name="privacy_s1_body">لا يقوم هذا التطبيق بجمع أو تخزين أو نقل أي معلومات شخصية. جميع بيانات القرارات (مثل خيارات العجلة والسجل) مخزنة محلياً على جهازك فقط.</string>
    <string name="privacy_s2_title">2. تخزين البيانات</string>
    <string name="privacy_s2_body">• جميع البيانات مخزنة محلياً باستخدام Android DataStore وقاعدة بيانات Room\n• لا يتم تحميل أي بيانات إلى أي خادم\n• إلغاء تثبيت التطبيق سيحذف جميع البيانات</string>
    <string name="privacy_s3_title">3. أمان البيانات</string>
    <string name="privacy_s3_body">بما أن جميع البيانات مخزنة محلياً، فإن خصوصيتك محمية بالكامل بواسطة آليات أمان Android.</string>
    <string name="privacy_s4_title">4. خدمات الطرف الثالث</string>
    <string name="privacy_s4_body">لا يدمج هذا التطبيق أي خدمات تحليلات أو إعلانات أو تتبع من أطراف ثالثة.</string>
    <string name="privacy_s5_title">5. استخدام الأذونات</string>
    <string name="privacy_s5_body">• إذن الاهتزاز: يُستخدم فقط للتغذية الراجعة اللمسية أثناء القرارات\n• لا تتطلب أذونات الشبكة أو التخزين أو الكاميرا أو غيرها</string>
    <string name="privacy_s6_title">6. شفافية المصادر المفتوحة</string>
    <string name="privacy_s6_body">هذا التطبيق مفتوح المصدر بالكامل. يمكنك الاطلاع على جميع الشيفرات المصدرية على GitHub.</string>
    <string name="privacy_s7_title">7. تحديثات السياسات</string>
    <string name="privacy_s7_body">سيتم إخطارك بأي تحديثات للسياسات داخل التطبيق.</string>
    <string name="privacy_s8_title">8. اتصل بنا</string>
    <string name="privacy_s8_body">لأي أسئلة متعلقة بالخصوصية، يرجى الاتصال بنا عبر GitHub Issues.</string>

    <!-- Terms of Use -->
    <string name="terms_last_updated">آخر تحديث: 8 يونيو 2026</string>
    <string name="terms_intro">مرحباً بك في Choice Paralysis Helper. هذا التطبيق برنامج مفتوح المصدر مصمم لمساعدة المستخدمين المتذبذبين في اتخاذ القرارات.</string>
    <string name="terms_s1_title">1. وصف الخدمة</string>
    <string name="terms_s1_body">يوفر هذا التطبيق أدوات القرار التالية: العجلة، العملة، النرد، Yes/No، وروليت الأصابع. جميع الميزات مجانية بدون مشتريات داخل التطبيق.</string>
    <string name="terms_s2_title">2. إرشادات الاستخدام</string>
    <string name="terms_s2_body">يرجى استخدام هذا التطبيق بمسؤولية. إنه مخصص للقرارات اليومية فقط ولا يناسب سيناريوهات المخاطر العالية.</string>
    <string name="terms_s3_title">3. إخلاء المسؤولية</string>
    <string name="terms_s3_body">يُقدم هذا التطبيق \"كما هو\" دون أي ضمان regarding دقة أو ملاءمة نتائج القرارات.</string>
    <string name="terms_s4_title">4. الملكية الفكرية</string>
    <string name="terms_s4_body">يُصدر هذا التطبيق بموجب رخصة Apache 2.0.</string>
    <string name="terms_s5_title">5. حقوق المستخدم</string>
    <string name="terms_s5_body">أنت حر في استخدام هذا التطبيق وتعدّله وتوزيعه، وفقاً لشروط رخصة Apache 2.0.</string>
    <string name="terms_s6_title">6. تحديد المسؤولية</string>
    <string name="terms_s6_body">في أقصى حد يسمح به القانون المعمول به، لن يكون المطور مسؤولاً عن أي أضرار ناتجة عن استخدام هذا التطبيق.</string>
    <string name="terms_s7_title">7. القانون المعمول به</string>
    <string name="terms_s7_body">تخضع هذه الشروط لقوانين جمهورية الصين الشعبية.</string>

    <!-- Open Source Licenses -->
    <string name="oss_intro">يستخدم هذا التطبيق مكتبات المصادر المفتوحة التالية:</string>
    <string name="oss_compose_desc">Jetpack Compose هو أدوات Android الحديثة لبناء واجهات أصلية.</string>
    <string name="oss_hilt_desc">Hilt هو مكتبة حقن التبعية لـ Android التي تبسّط استخدام Dagger.</string>
    <string name="oss_room_desc">يوفر Room طبقة تجريد فوق SQLite للسماح بوصول سلس لقاعدة البيانات مع الاستفادة من جميع إمكانيات SQLite.</string>
    <string name="oss_coil_desc">Coil هو مكتبة تحميل الصور لـ Android مدعومة بـ Kotlin Coroutines.</string>
    <string name="oss_navigation_desc">يوفر Navigation Compose دعم التنقل في Compose.</string>
    <string name="oss_datastore_desc">DataStore هو حل تخزين البيانات يتيح تخزين أزواج القيمة-المفتاح أو كائنات بروتوكول الع缓冲 بشكل غير متزامن ومتسق باستخدام Coroutines و Flow.</string>
    <string name="oss_copyright">جميع الحقوق محفوظة</string>
