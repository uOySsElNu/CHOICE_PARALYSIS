<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ChoiceParalysisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        tools:ignore="AppBundleLocaleChanges"
        android:supportsRtl="true"
        android:theme="@style/Theme.CHOICEPARALYSIS">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CHOICEPARALYSIS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Decision Widget -->
        <receiver
            android:name=".widget.QuickDecisionWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_decision_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.choiceparalysis.turntable.ACTION_DECIDE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_decision_widget_info" />
        </receiver>

        <!-- Last Result Widget -->
        <receiver
            android:name=".widget.LastResultWidgetProvider"
            android:exported="true"
            android:label="@string/widget_last_result_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/last_result_widget_info" />
        </receiver>
    </application>

</manifest>
