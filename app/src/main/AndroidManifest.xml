<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ChoiceParalysisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        tools:ignore="AppBundleLocaleChanges"
        android:supportsRtl="true"
        android:theme="@style/Theme.CHOICEPARALYSIS">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CHOICEPARALYSIS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== Quick Decision Widget ==================== -->
        <receiver
            android:name=".widget.QuickDecisionWidgetProvider"
            android:exported="true"
            android:process=":widgetprovider"
            android:label="@string/widget_quick_decision_title">

            <!-- Standard Android widget update -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <!-- Custom action: tap to decide -->
            <intent-filter>
                <action android:name="com.choiceparalysis.turntable.ACTION_DECIDE" />
            </intent-filter>

            <!-- Xiaomi HyperOS: clear-data refresh -->
            <intent-filter>
                <action android:name="miui.intent.action.MIUI_WIDGET_REFRESH_APP_DATA" />
            </intent-filter>

            <!-- Standard widget provider metadata -->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_decision_widget_info" />

            <!-- Xiaomi HyperOS: widget center identifier (lowercase!) -->
            <meta-data
                android:name="miuiwidget"
                android:value="true" />

            <!-- Xiaomi HyperOS: exposure refresh (lowercase!) -->
            <meta-data
                android:name="miuiwidgetrefreshtype"
                android:value="exposure" />
            <meta-data
                android:name="miuiwidgetrefreshmininterval"
                android:value="10000" />

            <!-- vivo OriginOS: atomic component version -->
            <meta-data
                android:name="vivoWidgetVersion"
                android:value="1" />
        </receiver>

        <!-- ==================== Last Result Widget ==================== -->
        <receiver
            android:name=".widget.LastResultWidgetProvider"
            android:exported="true"
            android:process=":widgetprovider"
            android:label="@string/widget_last_result_title">

            <!-- Standard Android widget update -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <!-- Xiaomi HyperOS: clear-data refresh -->
            <intent-filter>
                <action android:name="miui.intent.action.MIUI_WIDGET_REFRESH_APP_DATA" />
            </intent-filter>

            <!-- Standard widget provider metadata -->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/last_result_widget_info" />

            <!-- Xiaomi HyperOS: widget center identifier (lowercase!) -->
            <meta-data
                android:name="miuiwidget"
                android:value="true" />

            <!-- Xiaomi HyperOS: exposure refresh (lowercase!) -->
            <meta-data
                android:name="miuiwidgetrefreshtype"
                android:value="exposure" />
            <meta-data
                android:name="miuiwidgetrefreshmininterval"
                android:value="10000" />

            <!-- vivo OriginOS: atomic component version -->
            <meta-data
                android:name="vivoWidgetVersion"
                android:value="1" />
        </receiver>
    </application>

</manifest>
